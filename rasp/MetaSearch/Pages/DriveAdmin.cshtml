@page "/drive/admin"
@{
    Layout = null;
}
@* 회원 드라이브 관리 (사이트 관리자 전용). 권한 확인은 모두 서버 API(/api/drive/admin/*)에서 함 *@
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>회원 드라이브 관리</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <style>
        .adm { padding-block: 24px 64px; display: grid; gap: 28px; }
        .adm h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; }
        .adm .sub { color: var(--ink-2); font-size: 14px; }
        table.list { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
        .list th { text-align: left; font-size: 12.5px; font-weight: 600; color: var(--ink-3); padding: 8px 10px 8px 0; border-bottom: 2px solid var(--rule-strong); }
        .list td { padding: 10px 10px 10px 0; border-bottom: 1px solid var(--rule); vertical-align: middle; }
        .list tr.pick { cursor: pointer; }
        .list tr.pick:hover td { background: var(--tint); }
        .list .num { text-align: right; white-space: nowrap; }
        .bar { width: 120px; height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; display: inline-block; vertical-align: middle; margin-right: 8px; }
        .bar i { display: block; height: 100%; background: var(--accent); }
        .bar i.full { background: #d6336c; }
        .tag { font-size: 11.5px; font-weight: 700; color: var(--accent); margin-left: 6px; }
        .crumbs { display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 14px; align-items: center; }
        .crumbs button, .linkish { background: none; border: 0; padding: 0; font: inherit; color: var(--ink); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
        .crumbs span { color: var(--ink-3); }
        .act { display: flex; gap: 6px; justify-content: flex-end; }
        .act a, .act button { height: 28px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; }
        .act a:hover, .act button:hover { border-color: var(--ink); }
        .act .del:hover { border-color: #d6336c; color: #d6336c; }
        .msg { color: var(--ink-2); }
        .scroll { overflow-x: auto; }
        @@media (max-width: 640px) { .bar { width: 64px; } .hide-sm { display: none; } }
    </style>
</head>
<body class="p-drive">
    <div class="wrap">
        <header class="topbar">
            <a href="/drive/files" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>내 드라이브</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
            </div>
        </header>

        <main class="adm">
            <div>
                <h1>회원 드라이브 관리</h1>
                <p class="sub">회원마다 3GB(휴지통 포함). 운영·불법 파일 대응 목적으로만 열람하고, 삭제는 되돌릴 수 없습니다.</p>
            </div>
            <p class="msg" id="msg">불러오는 중…</p>
            <!-- 회원 목록 -->
            <section id="users" hidden>
                <div class="scroll">
                    <table class="list">
                        <thead><tr><th>아이디</th><th class="hide-sm">닉네임</th><th>사용량</th><th class="num">파일</th></tr></thead>
                        <tbody id="userRows"></tbody>
                    </table>
                </div>
            </section>
            <!-- 선택한 회원의 파일 -->
            <section id="files" hidden>
                <div class="crumbs" id="crumbs"></div>
                <div class="scroll">
                    <table class="list">
                        <thead><tr><th>이름</th><th class="num">크기</th><th class="num hide-sm">수정</th><th></th></tr></thead>
                        <tbody id="fileRows"></tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
    <script>
        // 드라이브 토큰(내 드라이브에서 받은 것)으로 관리자 API 호출. 서버가 관리자 여부를 다시 확인함
        var TOKEN = ''; try { TOKEN = localStorage.getItem('driveToken') || ''; } catch (e) { }
        var AUTH = { Authorization: 'Bearer ' + TOKEN };
        var msg = document.getElementById('msg');
        var QUOTA = 3 * 1024 * 1024 * 1024, cur = null;   // cur: 보고 있는 회원 { id, username }

        function size(b) { if (!b) return '0 B'; var u = ['B', 'KB', 'MB', 'GB', 'TB'], i = Math.floor(Math.log(b) / Math.log(1024)); return (b / Math.pow(1024, i)).toFixed(i ? 1 : 0) + ' ' + u[i]; }
        function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
        function get(url) {
            return fetch(url, { headers: AUTH, credentials: 'same-origin' }).then(function (r) {
                if (r.status === 401) throw new Error('auth');
                if (!r.ok) throw new Error('http');
                return r.json();
            });
        }
        function fail(e) {
            msg.hidden = false;
            msg.textContent = e.message === 'auth' ? '관리자 계정으로 내 드라이브에 먼저 들어온 뒤 다시 열어 주세요.' : '불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
            if (e.message === 'auth') { var a = el('a', ' 내 드라이브 열기', 'linkish'); a.href = '/drive'; msg.appendChild(a); }
        }

        // ── 회원 목록 ──
        function loadUsers() {
            get('/api/drive/admin/users').then(function (d) {
                QUOTA = d.quota || QUOTA;
                var tb = document.getElementById('userRows'); tb.textContent = '';
                d.users.forEach(function (u) {
                    var tr = el('tr', null, 'pick'); tr.tabIndex = 0;
                    var id = el('td', u.username); if (u.isAdmin) id.appendChild(el('span', '관리자', 'tag'));
                    tr.appendChild(id);
                    tr.appendChild(el('td', u.nickname || '—', 'hide-sm'));
                    var use = el('td'), bar = el('span', null, 'bar'), fill = el('i');
                    var pct = u.isAdmin ? 0 : Math.min(100, u.usage / QUOTA * 100);
                    fill.style.width = pct + '%'; if (pct >= 95) fill.className = 'full';
                    bar.appendChild(fill); use.appendChild(bar);
                    use.appendChild(document.createTextNode(size(u.usage) + (u.isAdmin ? ' (무제한)' : ' / ' + size(QUOTA))));
                    tr.appendChild(use);
                    tr.appendChild(el('td', String(u.files), 'num'));
                    var open = function () { cur = { id: u.id, username: u.username }; openFolder(null); };
                    tr.addEventListener('click', open);
                    tr.addEventListener('keydown', function (e) { if (e.key === 'Enter') open(); });
                    tb.appendChild(tr);
                });
                msg.hidden = true;
                document.getElementById('files').hidden = true;
                document.getElementById('users').hidden = false;
            }).catch(fail);
        }

        // ── 회원 파일 (폴더 단위) ──
        function openFolder(folderId) {
            get('/api/drive/admin/list?user=' + cur.id + (folderId ? '&folder=' + folderId : '')).then(function (d) {
                var cr = document.getElementById('crumbs'); cr.textContent = '';
                var all = el('button', '회원 목록'); all.type = 'button'; all.onclick = loadUsers; cr.appendChild(all);
                cr.appendChild(el('span', '/'));
                var root = el('button', d.username || cur.username); root.type = 'button'; root.onclick = function () { openFolder(null); }; cr.appendChild(root);
                d.breadcrumb.forEach(function (b) {
                    cr.appendChild(el('span', '/'));
                    var bb = el('button', b.name); bb.type = 'button'; bb.onclick = function () { openFolder(b.id); }; cr.appendChild(bb);
                });
                var tb = document.getElementById('fileRows'); tb.textContent = '';
                if (!d.files.length) { var tr0 = el('tr'), td0 = el('td', '비어 있습니다.'); td0.colSpan = 4; tr0.appendChild(td0); tb.appendChild(tr0); }
                d.files.forEach(function (f) {
                    var tr = el('tr'), name = el('td');
                    if (f.isFolder) { var fb = el('button', f.fileName + '/', 'linkish'); fb.type = 'button'; fb.onclick = function () { openFolder(f.id); }; name.appendChild(fb); }
                    else name.textContent = f.fileName;
                    tr.appendChild(name);
                    tr.appendChild(el('td', f.isFolder ? '—' : size(f.fileSize), 'num'));
                    tr.appendChild(el('td', new Date(f.updatedAt).toLocaleDateString('ko-KR'), 'num hide-sm'));
                    var act = el('td'), box = el('div', null, 'act');
                    if (!f.isFolder) {
                        var dl = el('a', '내려받기');
                        dl.href = '/api/drive/admin/download/' + cur.id + '/' + f.id + '?token=' + encodeURIComponent(TOKEN);
                        box.appendChild(dl);
                    }
                    var del = el('button', '삭제', 'del'); del.type = 'button';
                    del.onclick = function () {
                        if (!confirm('"' + f.fileName + '"' + (f.isFolder ? ' 폴더와 안의 파일을 모두' : '을(를)') + ' 지웁니다. 되돌릴 수 없습니다.')) return;
                        fetch('/api/drive/admin/delete/' + cur.id + '/' + f.id, { method: 'DELETE', headers: AUTH, credentials: 'same-origin' })
                            .then(function (r) { if (!r.ok) throw new Error('http'); tr.remove(); })
                            .catch(function () { alert('삭제하지 못했습니다.'); });
                    };
                    box.appendChild(del); act.appendChild(box); tr.appendChild(act);
                    tb.appendChild(tr);
                });
                document.getElementById('users').hidden = true;
                document.getElementById('files').hidden = false;
            }).catch(fail);
        }

        if (!TOKEN) fail(new Error('auth')); else loadUsers();
    </script>
</body>
</html>
