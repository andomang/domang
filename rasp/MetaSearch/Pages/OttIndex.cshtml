@page "/ottindex"
@model OttIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTT Multi-View — 프로젝트 소개</title>
    <meta name="description" content="OTT Multi-View 데스크탑 멀티뷰어 프로젝트 소개. 넷플릭스, 유튜브 등 최대 4개 동시 시청." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/ottindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/ottindex" />
    <meta property="og:title" content="OTT Multi-View — 프로젝트 소개" />
    <meta property="og:description" content="OTT Multi-View 데스크탑 멀티뷰어 프로젝트 소개. 넷플릭스, 유튜브 등 최대 4개 동시 시청." />
    <meta property="og:image" content="https://domang.org/img/og/ott.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OTT Multi-View — 프로젝트 소개" />
    <meta name="twitter:description" content="OTT Multi-View 데스크탑 멀티뷰어 프로젝트 소개. 넷플릭스, 유튜브 등 최대 4개 동시 시청." />
    <meta name="twitter:image" content="https://domang.org/img/og/ott.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": "OTT Multi-View",
      "url": "https://domang.org/ottindex",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Windows",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "downloadUrl": "https://github.com/andomang/OTT/releases",
      "description": "OTT Multi-View 데스크탑 멀티뷰어 프로젝트 소개. 넷플릭스, 유튜브 등 최대 4개 동시 시청.",
      "image": "https://domang.org/img/og/ott.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />

    <style>
        /* ── 리셋 ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0f0d;
            --bg-card: #141f1a;
            --border: #1e3a2d;
            --text-primary: #e8f0ec;
            --text-secondary: #8fa89a;
            --text-muted: #5a7568;
            --accent: #e50914;
            --accent-dim: rgba(229, 9, 20, 0.12);
            --accent-glow: rgba(229, 9, 20, 0.25);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-mono: 'JetBrains Mono', 'Consolas', monospace;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: '';
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 20%, rgba(229, 9, 20, 0.05) 0%, transparent 60%),
                        radial-gradient(ellipse at 70% 80%, rgba(255, 107, 53, 0.04) 0%, transparent 60%);
            z-index: -1;
        }

        .container { max-width: 720px; margin: 0 auto; padding: 0 20px 80px; }

        /* ── 상단 바 ── */
        .top-bar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 0; margin-bottom: 32px; border-bottom: 1px solid var(--border);
        }

        .back-link {
            display: flex; align-items: center; gap: 8px;
            font-size: 14px; color: var(--text-muted); text-decoration: none; transition: color 0.2s;
        }
        .back-link:hover { color: var(--text-primary); }
        .back-link svg { width: 16px; height: 16px; }

        .goto-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 24px; background: var(--accent); color: white;
            font-size: 14px; font-weight: 600; border-radius: 10px; text-decoration: none;
            transition: all 0.2s ease; box-shadow: 0 4px 16px var(--accent-glow);
        }
        .goto-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 24px var(--accent-glow); }
        .goto-btn svg { width: 16px; height: 16px; }

        /* Desktop 배지 스타일 */
        .goto-btn.desktop {
            background: linear-gradient(135deg, #e50914, #ff6b35);
        }

        /* ── 히어로 ── */
        .hero { text-align: center; margin-bottom: 48px; }

        .hero-icon {
            width: 80px; height: 80px; border-radius: 20px;
            background: linear-gradient(135deg, #e50914, #ff6b35);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 24px; box-shadow: 0 8px 32px var(--accent-glow);
        }
        .hero-icon svg {
            width: 40px; height: 40px; fill: none; stroke: white;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .hero h1 { font-size: 32px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 8px; }

        .hero-badge {
            display: inline-block; font-size: 11px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.5px; padding: 3px 10px; border-radius: 6px;
            margin-bottom: 16px;
        }

        .hero-badge.desktop {
            background: rgba(229, 9, 20, 0.12);
            color: #ff6b6b;
        }

        .hero p { font-size: 16px; color: var(--text-secondary); line-height: 1.7; max-width: 560px; margin: 0 auto; }

        .hero-img {
            width: 100%; border-radius: 16px; border: 1px solid var(--border);
            margin-bottom: 48px; box-shadow: 0 8px 40px rgba(0,0,0,0.3);
        }

        /* ── 기능 ── */
        .section-title {
            font-size: 12px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 2px; color: var(--text-muted); margin-bottom: 20px; padding-left: 4px;
        }

        .features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }

        .feature-item {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
        }

        .feature-icon {
            flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px;
            background: var(--accent-dim); display: flex; align-items: center; justify-content: center;
        }
        .feature-icon svg {
            width: 18px; height: 18px; fill: none; stroke: var(--accent);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .feature-text h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
        .feature-text p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

        /* 보안 항목 강조 */
        .feature-item.security {
            border-color: rgba(62, 207, 142, 0.3);
            background: rgba(62, 207, 142, 0.04);
        }
        .feature-item.security .feature-icon {
            background: rgba(62, 207, 142, 0.12);
        }
        .feature-item.security .feature-icon svg {
            stroke: #3ecf8e;
        }
        .feature-item.security h3 {
            color: #3ecf8e;
        }

        /* ── 기술 스택 ── */
        .tech-section { margin-bottom: 40px; }
        .tech-grid { display: flex; flex-wrap: wrap; gap: 8px; }
        .tech-chip {
            font-family: var(--font-mono); font-size: 12px; padding: 6px 14px; border-radius: 8px;
            background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border);
        }

        /* ── 플랫폼 안내 ── */
        .platform-note {
            display: flex; align-items: center; gap: 12px;
            padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; margin-bottom: 40px;
        }

        .platform-note svg {
            flex-shrink: 0; width: 20px; height: 20px;
            fill: none; stroke: var(--text-muted);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .platform-note p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

        /* ── 하단 ── */
        .bottom-cta { text-align: center; padding-top: 40px; border-top: 1px solid var(--border); }
        .bottom-cta p { font-size: 14px; color: var(--text-muted); margin-bottom: 16px; }

        /* ── 연락처 & 저작권 ── */
        .site-footer {
            text-align: center; margin-top: 40px; padding-top: 24px;
            border-top: 1px solid var(--border);
        }
        .footer-contact {
            display: flex; align-items: center; justify-content: center;
            flex-wrap: wrap; gap: 6px; font-size: 13px;
            color: var(--text-muted); margin-bottom: 10px;
        }
        .footer-name { font-weight: 600; color: var(--text-secondary); }
        .footer-divider { opacity: 0.4; }
        .footer-email { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
        .footer-email:hover { opacity: 0.8; }
        .footer-copyright { font-size: 12px; color: var(--text-muted); opacity: 0.6; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both; }
        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }

        @@media (max-width: 480px) {
            .hero h1 { font-size: 24px; }
            .hero-icon { width: 64px; height: 64px; border-radius: 16px; }
            .hero-icon svg { width: 32px; height: 32px; }
            .top-bar { flex-direction: column; gap: 12px; align-items: stretch; text-align: center; }
            .goto-btn { justify-content: center; }
        }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body>
    <div class="container">

        <!-- 상단 바로가기 -->
        <div class="top-bar animate-in">
            <a href="/" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                포트폴리오로 돌아가기
            </a>
            <a href="https://github.com/andomang/OTT/releases" target="_blank" class="goto-btn desktop">
                GitHub 다운로드
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                </svg>
            </a>
        </div>

        <!-- 히어로 -->
        <div class="hero animate-in delay-1">
            <div class="hero-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <line x1="8" y1="21" x2="16" y2="21" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
            </div>
            <span class="hero-badge desktop">Desktop App</span>
            <h1>OTT Multi-View</h1>
            <p>
                넷플릭스, 유튜브, 디즈니+ 등 OTT 서비스를 최대 4개까지 동시에 시청하는 Windows 데스크탑 앱입니다.
                WebView2 기반으로 각 화면을 독립적으로 제어하며, PiP 모드와 레이아웃 저장을 지원합니다.
            </p>
        </div>

        <!-- 썸네일 -->
        <img src="/img/ott-card.png" alt="OTT Multi-View 스크린샷" class="hero-img animate-in delay-2" />

        <!-- 주요 기능 -->
        <div class="section-title animate-in delay-2">주요 기능</div>
        <div class="features animate-in delay-2">
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                </div>
                <div class="feature-text">
                    <h3>멀티뷰 (최대 4분할)</h3>
                    <p>화면을 1~4개로 분할하여 서로 다른 OTT를 동시에 시청합니다. 드래그로 칸 위치를 교체할 수 있습니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><rect x="2" y="2" width="8" height="8" rx="1" /><rect x="14" y="14" width="8" height="8" rx="1" /></svg>
                </div>
                <div class="feature-text">
                    <h3>PiP (Picture-in-Picture)</h3>
                    <p>선택한 화면을 항상 위 작은 창으로 분리합니다. 다른 작업을 하면서도 영상을 계속 볼 수 있습니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /></svg>
                </div>
                <div class="feature-text">
                    <h3>개별 음량 조절 &amp; 음소거</h3>
                    <p>각 화면의 음량을 독립적으로 조절하고 음소거할 수 있습니다. 하나만 소리를 키우고 나머지는 음소거하는 식으로 사용합니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                </div>
                <div class="feature-text">
                    <h3>레이아웃 저장 &amp; 복원</h3>
                    <p>현재 열어둔 OTT 조합과 화면 분할 비율을 저장해두고, 다음 접속 시 한 번에 복원합니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </div>
                <div class="feature-text">
                    <h3>회원 시스템</h3>
                    <p>로그인·회원가입·닉네임 변경·비밀번호 변경·통계 확인 기능을 내장합니다. MSSQL DB에 안전하게 저장합니다.</p>
                </div>
            </div>
            <div class="feature-item security">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                </div>
                <div class="feature-text">
                    <h3>OTT 계정 보안</h3>
                    <p>넷플릭스·유튜브 등의 OTT 계정 정보는 서버에 일절 저장되지 않습니다. 로그인 세션은 사용자 PC 내부 드라이브에 WebView2 쿠키로만 저장되며, 외부로 전송되지 않습니다. 앱을 삭제하면 쿠키도 함께 제거됩니다.</p>
                </div>
            </div>
        </div>

        <!-- 기술 스택 -->
        <div class="tech-section animate-in delay-3">
            <div class="section-title">기술 스택</div>
            <div class="tech-grid">
                <span class="tech-chip">C# WinForms</span>
                <span class="tech-chip">.NET 8</span>
                <span class="tech-chip">WebView2</span>
                <span class="tech-chip">MSSQL</span>
                <span class="tech-chip">Dapper</span>
                <span class="tech-chip">BCrypt</span>
            </div>
        </div>

        <!-- 플랫폼 안내 -->
        <div class="platform-note animate-in delay-3">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
            <p>Windows 전용 데스크탑 앱입니다. WebView2 런타임이 필요하며, Windows 10 이상에서 동작합니다.</p>
        </div>

        <!-- 하단 -->
        <div class="bottom-cta animate-in delay-4">
            <p>프로젝트 다운로드</p>
            <a href="https://github.com/andomang/OTT/releases" target="_blank" class="goto-btn desktop">
                GitHub 다운로드
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                </svg>
            </a>
        </div>

        <!-- 연락처 & 저작권 -->
        <!-- 광고: 본문 아래 -->
        <div style="margin:24px 0"><partial name="_AdUnit" model='@("inline")' /></div>

        <footer class="site-footer animate-in delay-5">
            <div class="footer-contact">
                <span class="footer-name">안도영</span>
                <span class="footer-divider">·</span>
                <svg class="footer-ico" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <span>010-2583-1894</span>
                <span class="footer-divider">·</span>
                <svg class="footer-ico" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                <a href="mailto:metasearch@@domang.org" class="footer-email">metasearch@@domang.org</a>
            </div>
            <p class="footer-copyright">&copy; 2026 안도영 (domang.org). All rights reserved. · <a href="/Privacy" style="color:inherit;text-decoration:underline">개인정보처리방침</a></p>
        </footer>

    </div>
</body>
</html>
