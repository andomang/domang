@page "/pokeindex"
@model PokeIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>포켓몬스터 아스테라 — 프로젝트 소개</title>
    <meta name="description" content="포켓몬스터 아스테라: 신대륙 아스테라를 무대로 한 오리지널 스토리 브라우저 팬게임." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/pokeindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/pokeindex" />
    <meta property="og:title" content="포켓몬스터 아스테라 — 프로젝트 소개" />
    <meta property="og:description" content="포켓몬스터 아스테라: 신대륙 아스테라를 무대로 한 오리지널 스토리 브라우저 팬게임." />
    <meta property="og:image" content="https://domang.org/img/og/pokemon.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="포켓몬스터 아스테라 — 프로젝트 소개" />
    <meta name="twitter:description" content="포켓몬스터 아스테라: 신대륙 아스테라를 무대로 한 오리지널 스토리 브라우저 팬게임." />
    <meta name="twitter:image" content="https://domang.org/img/og/pokemon.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "VideoGame",
      "name": "포켓몬스터 아스테라",
      "url": "https://domang.org/pokemon",
      "gamePlatform": [
        "Web browser",
        "PC",
        "Mobile"
      ],
      "genre": "RPG",
      "playMode": "SinglePlayer",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "description": "포켓몬스터 아스테라: 신대륙 아스테라를 무대로 한 오리지널 스토리 브라우저 팬게임.",
      "image": "https://domang.org/img/og/pokemon.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />

    <style>
        /* ── 리셋 ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0f0d;
            --bg-card: #141f1a;
            --border: #1e3a2d;
            --text-primary: #e8f0ec;
            --text-secondary: #8fa89a;
            --text-muted: #5a7568;
            --accent: #f8d030;
            --accent-dim: rgba(248, 208, 48, 0.12);
            --accent-glow: rgba(248, 208, 48, 0.25);
            --red: #e53935;
            --red-dim: rgba(229, 57, 53, 0.12);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-mono: 'JetBrains Mono', 'Consolas', monospace;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: '';
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 20%, rgba(248, 208, 48, 0.05) 0%, transparent 60%),
                        radial-gradient(ellipse at 70% 80%, rgba(229, 57, 53, 0.04) 0%, transparent 60%);
            z-index: -1;
        }

        .container { max-width: 720px; margin: 0 auto; padding: 0 20px 80px; }

        /* ── 상단 바 ── */
        .top-bar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 0; margin-bottom: 32px; border-bottom: 1px solid var(--border);
        }

        .back-link {
            display: flex; align-items: center; gap: 8px;
            font-size: 14px; color: var(--text-muted); text-decoration: none; transition: color 0.2s;
        }
        .back-link:hover { color: var(--text-primary); }
        .back-link svg { width: 16px; height: 16px; }

        .goto-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 24px; background: var(--red); color: white;
            font-size: 14px; font-weight: 600; border-radius: 10px; text-decoration: none;
            transition: all 0.2s ease; box-shadow: 0 4px 16px var(--accent-glow);
        }
        .goto-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 24px var(--accent-glow); }
        .goto-btn svg { width: 16px; height: 16px; }

        /* ── 히어로 ── */
        .hero { text-align: center; margin-bottom: 48px; }

        .hero-icon {
            width: 80px; height: 80px; border-radius: 50%;
            background: linear-gradient(135deg, var(--red), var(--accent));
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 24px; box-shadow: 0 8px 32px var(--accent-glow);
            position: relative;
        }
        /* 몬스터볼 디자인 */
        .hero-icon::before {
            content: '';
            position: absolute;
            top: 50%; left: 10%; right: 10%;
            height: 4px; background: #303030;
            transform: translateY(-50%);
            border-radius: 2px;
        }
        .hero-icon::after {
            content: '';
            position: absolute;
            width: 20px; height: 20px;
            border-radius: 50%;
            background: white;
            border: 4px solid #303030;
        }

        .hero h1 { font-size: 32px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 8px; }
        .hero h1 span { color: var(--accent); }

        .hero-badge {
            display: inline-block; font-size: 11px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.5px; padding: 3px 10px; border-radius: 6px;
            background: var(--red-dim); color: var(--red);
            margin-bottom: 16px;
        }

        .hero p { font-size: 16px; color: var(--text-secondary); line-height: 1.7; max-width: 560px; margin: 0 auto; }

        /* ── 기능 ── */
        .section-title {
            font-size: 12px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 2px; color: var(--text-muted); margin-bottom: 20px; padding-left: 4px;
        }

        .features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }

        .feature-item {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
        }

        .feature-icon {
            flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px;
            background: var(--accent-dim); display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }

        .feature-text h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
        .feature-text p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

        /* ── 기술 스택 ── */
        .tech-section { margin-bottom: 40px; }
        .tech-grid { display: flex; flex-wrap: wrap; gap: 8px; }
        .tech-chip {
            font-family: var(--font-mono); font-size: 12px; padding: 6px 14px; border-radius: 8px;
            background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border);
        }

        /* ── 지역별 출현 정보 ── */
        .enc-rules { display: grid; gap: 8px; margin-bottom: 14px; }
        .enc-rule { display: flex; gap: 12px; padding: 12px 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; }
        .enc-rule span { flex: 0 0 96px; font-size: 13px; font-weight: 700; color: var(--accent); }
        .enc-rule p { font-size: 13px; color: var(--text-secondary); line-height: 1.6; min-width: 0; }
        .enc-rule b { color: var(--text-primary); }
        .enc-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; }
        .enc-map { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 0 16px; }
        .enc-map summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; }
        .enc-map summary::-webkit-details-marker { display: none; }
        .enc-map summary b { font-size: 15px; }
        .enc-map summary em { font-style: normal; font-size: 12px; color: var(--text-muted); text-align: right; }
        .enc-map[open] summary { border-bottom: 1px solid var(--border); }
        .enc-h { font-size: 12px; font-weight: 700; color: var(--accent); margin: 14px 0 8px; }
        .enc-p { font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 14px; }
        .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
        .chip { font-size: 12px; padding: 4px 10px; border-radius: 8px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: var(--text-primary); }
        .chip i { font-style: normal; color: var(--text-muted); font-variant-numeric: tabular-nums; margin-left: 2px; }
        .enc-lg { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
        .enc-lg li { font-size: 13px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
        .enc-lg small { flex-basis: 100%; color: var(--text-muted); font-size: 12px; padding-left: 44px; }
        .enc-lg .k { font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 5px; }
        .enc-lg .k.leg { background: var(--accent-dim); color: var(--accent); }
        .enc-lg .k.myth { background: rgba(240, 128, 224, 0.14); color: #f080e0; }
        @@media (max-width: 480px) { .enc-rule { flex-direction: column; gap: 4px; } .enc-rule span { flex: none; } }

        /* ── 주의사항 ── */
        .notice {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; margin-bottom: 40px;
        }
        .notice svg {
            flex-shrink: 0; width: 20px; height: 20px;
            fill: none; stroke: var(--accent);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
            margin-top: 2px;
        }
        .notice p { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }
        .notice strong { color: var(--accent); }

        /* ── 하단 ── */
        .bottom-cta { text-align: center; padding-top: 40px; border-top: 1px solid var(--border); }
        .bottom-cta p { font-size: 14px; color: var(--text-muted); margin-bottom: 16px; }

        /* ── 연락처 & 저작권 ── */
        .site-footer {
            text-align: center; margin-top: 40px; padding-top: 24px;
            border-top: 1px solid var(--border);
        }
        .footer-contact {
            display: flex; align-items: center; justify-content: center;
            flex-wrap: wrap; gap: 6px; font-size: 13px;
            color: var(--text-muted); margin-bottom: 10px;
        }
        .footer-name { font-weight: 600; color: var(--text-secondary); }
        .footer-divider { opacity: 0.4; }
        .footer-ico {
            width: 14px; height: 14px; flex-shrink: 0;
            fill: none; stroke: var(--text-muted);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .footer-email { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
        .footer-email:hover { opacity: 0.8; }
        .footer-copyright { font-size: 12px; color: var(--text-muted); opacity: 0.6; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both; }
        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }
        .delay-5 { animation-delay: 0.40s; }

        @@media (max-width: 480px) {
            .hero h1 { font-size: 24px; }
            .hero-icon { width: 64px; height: 64px; }
            .top-bar { flex-direction: column; gap: 12px; align-items: stretch; text-align: center; }
            .goto-btn { justify-content: center; }
        }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body>
    <div class="container">

        <!-- 상단 바로가기 -->
        <div class="top-bar animate-in">
            <a href="/" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                포트폴리오로 돌아가기
            </a>
            <a href="/pokemon" class="goto-btn">
                게임 플레이
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3" />
                </svg>
            </a>
        </div>

        <!-- 히어로 -->
        <div class="hero animate-in delay-1">
            <div class="hero-icon"></div>
            <span class="hero-badge">Fan Game · 2D Pixel</span>
            <h1>포켓몬스터 <span>아스테라</span></h1>
            <p>
                200년 전 가라앉았다가 "시공의 균열"과 함께 떠오른 신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임.
                1~9세대 포켓몬과 전설·환상 포켓몬이 함께 살아가는 대륙을 탐험하며 8개 체육관과 포켓몬리그에 도전합니다.
                설치 없이 브라우저에서 바로 플레이할 수 있습니다.
            </p>
        </div>

        <!-- 주요 기능 -->
        <div class="section-title animate-in delay-2">특징</div>
        <div class="features animate-in delay-2">
            <div class="feature-item">
                <div class="feature-icon">🗺️</div>
                <div class="feature-text">
                    <h3>오리지널 스토리와 대륙</h3>
                    <p>체육관 8곳, 악당 조직 균열단, 사천왕과 챔피언, 엔딩 후 균열 지대와 배틀 타워까지. 챕터 카드와 모험 수첩이 다음 목표를 알려줍니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">⚔️</div>
                <div class="feature-text">
                    <h3>세대별 배틀 기믹</h3>
                    <p>메가진화, 다이맥스·거다이맥스, 테라스탈, Z기술, 원시회귀를 지원합니다. 맥스 레이드와 테라 레이드 둥지도 있습니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">✨</div>
                <div class="feature-text">
                    <h3>포켓몬 1025종 + 폼 438종</h3>
                    <p>지역 폼과 메가·거다이맥스 폼을 포함한 도감, 특성 310종, 기술 920개. 동료 포켓몬이 뒤를 따라 걷습니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">💾</div>
                <div class="feature-text">
                    <h3>회원 서버 저장</h3>
                    <p>domang.org 회원으로 로그인하면 기록과 키 설정이 계정에 저장되어 다른 기기에서도 이어서 할 수 있습니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📱</div>
                <div class="feature-text">
                    <h3>PC · 모바일 지원</h3>
                    <p>키보드 키 설정, 배속(1~8배), 위치를 옮길 수 있는 모바일 가상 컨트롤러를 지원합니다.</p>
                </div>
            </div>
        </div>

        <!-- ENCOUNTERS:START (자동 생성: 게임 데이터에서 뽑은 출현 정보) -->
        <div class="section-title animate-in delay-3">지역별 출현 포켓몬 · 확률</div>
        <div class="enc-rules animate-in delay-3">
            <div class="enc-rule"><span>풀숲 야생 조우</span><p>풀숲에서 한 걸음마다 <b>9%</b></p></div>
            <div class="enc-rule"><span>배회 전설</span><p>배지 5개 이후 풀숲 한 걸음마다 <b>약 0.45%</b> (1/220) · 엔테이, 라이코, 스이쿤, 라티아스, 라티오스, 토네로스, 볼트로스, 파이어, 썬더, 프리져, 크레세리아</p></div>
            <div class="enc-rule"><span>환상의 풀숲</span><p>조우 1번당 <b>3%</b>가 전설·환상 125종 중 무작위(각 약 0.024%), 97%는 일반 900종 중 무작위(각 약 0.108%) · Lv.40~60</p></div>
            <div class="enc-rule"><span>필드 전설·환상</span><p>맵에 서 있는 전설에게 말을 걸면 <b>100%</b> 전투 (조건이 있는 경우 조건을 만족해야 함) · 쓰러뜨려도 다시 나타남</p></div>
            <div class="enc-rule"><span>이로치</span><p>야생 <b>1/512</b> (빛나는부적 1/128) · 필드 전설 1/100 · 레이드 1/200</p></div>
        </div>
        <div class="enc-list animate-in delay-3">
            <details class="enc-map">
                <summary><b>1번도로</b><em>Lv.2~5</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">구구 <i>19.6%</i></span><span class="chip">꼬렛 <i>19.6%</i></span><span class="chip">꼬리선 <i>11.8%</i></span><span class="chip">비버니 <i>11.8%</i></span><span class="chip">요테리 <i>9.8%</i></span><span class="chip">영구스 <i>7.8%</i></span><span class="chip">탐리스 <i>7.8%</i></span><span class="chip">맛보돈 <i>5.9%</i></span><span class="chip">화살꼬빈 <i>2.9%</i></span><span class="chip">우르 <i>2.9%</i></span></div>
            </details>
            <details class="enc-map">
                <summary><b>2번도로</b><em>Lv.5~9</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">캐터피 <i>12%</i></span><span class="chip">뿔충이 <i>12%</i></span><span class="chip">니드런♀ <i>10%</i></span><span class="chip">니드런♂ <i>10%</i></span><span class="chip">보르쥐 <i>10%</i></span><span class="chip">포챠나 <i>10%</i></span><span class="chip">지그제구리 <i>10%</i></span><span class="chip">찌르꼬 <i>9%</i></span><span class="chip">꼬링크 <i>8%</i></span><span class="chip">피카츄 <i>4%</i></span><span class="chip">랄토스 <i>3%</i></span><span class="chip">이브이 <i>2%</i></span></div>
            </details>
