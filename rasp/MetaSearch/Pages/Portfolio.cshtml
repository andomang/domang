    <!-- 파비콘: Higgsfield 생성 아이콘 사용 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />

    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />

    <style>
        /* ── 리셋 + 기본 설정 ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0f0d;
            --bg-card: #141f1a;
            --bg-card-hover: #1a2b23;
            --border: #1e3a2d;
            --border-hover: #2d5a43;
            --text-primary: #e8f0ec;
            --text-secondary: #8fa89a;
            --text-muted: #5a7568;
            --accent: #3ecf8e;
            --accent-dim: rgba(62, 207, 142, 0.12);
            --accent-glow: rgba(62, 207, 142, 0.25);
            --purple: #a78bfa;
            --blue: #60a5fa;
            --pink: #f472b6;
            --orange: #fb923c;
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-mono: 'JetBrains Mono', 'Consolas', monospace;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── 배경 그라데이션 효과 ── */
        body::before {
            content: '';
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 20%, rgba(62, 207, 142, 0.06) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 80%, rgba(167, 139, 250, 0.04) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── 메인 레이아웃 ── */
        .container {
            position: relative;
            z-index: 1;
            max-width: 720px;
            margin: 0 auto;
            padding: 60px 20px 80px;
        }

        /* ── 프로필 헤더 ── */
        .profile {
            text-align: center;
            margin-bottom: 56px;
        }

        /* 프로필 아바타 (이니셜) */
        .profile-avatar {
            width: 88px; height: 88px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--purple));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 36px;
            font-weight: 800;
            color: var(--bg);
            box-shadow: 0 0 40px var(--accent-glow);
        }

        .profile-handle {
            font-family: var(--font-mono);
            font-size: 14px;
            color: var(--accent);
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .profile-name {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 10px;
        }

        .profile-bio {
            font-size: 15px;
            color: var(--text-secondary);
            line-height: 1.6;
            max-width: 480px;
            margin: 0 auto;
        }

        /* ── 섹션 제목 ── */
        .section-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-muted);
            margin-bottom: 20px;
            padding-left: 4px;
        }

        /* ── 프로젝트 카드 그리드 ── */
        .projects {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .project-card {
            display: flex;
            flex-direction: column;
            gap: 0;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 0;
            text-decoration: none;
            color: inherit;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        /* 카드 헤더 (아이콘 + 텍스트 + 화살표) */
        .card-header {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px 20px 0 20px;
        }

        .project-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent 60%, var(--card-accent, var(--accent-dim)));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .project-card:hover {
            background: var(--bg-card-hover);
            border-color: var(--border-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--border-hover);
        }

        .project-card:hover::before { opacity: 1; }

        .project-card:active {
            transform: translateY(0);
            transition-duration: 0.1s;
        }

        /* 카드 아이콘 (생성 이미지 사용) */
        .card-icon-img {
            width: 52px; height: 52px;
            border-radius: 14px;
            object-fit: cover;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }


        /* 카드 텍스트 */
        .card-body {
            flex: 1;
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .card-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-badge {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 8px;
            border-radius: 6px;
            background: var(--accent-dim);
            color: var(--accent);
        }

        /* Desktop 앱 배지 (빨간 계열) */
        .card-badge.desktop {
            background: rgba(229, 9, 20, 0.12);
            color: #ff6b6b;
        }

        .card-desc {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* 카드 화살표 */
        .card-arrow {
            flex-shrink: 0;
            width: 20px; height: 20px;
            color: var(--text-muted);
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        .project-card:hover .card-arrow {
            color: var(--accent);
            transform: translateX(4px);
        }

        /* ── 기술 스택 태그 ── */
        .tech-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 12px 20px 16px;
        }

        .tech-tag {
            font-family: var(--font-mono);
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        /* ── 하단 링크 ── */
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 56px;
            padding-top: 32px;
            border-top: 1px solid var(--border);
        }

        .footer-link {
            font-size: 13px;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer-link:hover { color: var(--accent); }

        /* ── 연락처 & 저작권 ── */
        .site-footer {
            text-align: center;
            margin-top: 32px;
            padding-top: 24px;
        }

        .footer-contact {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        .footer-name { font-weight: 600; color: var(--text-secondary); }
        .footer-divider { opacity: 0.4; }
        .footer-ico {
            width: 14px; height: 14px; flex-shrink: 0;
            fill: none; stroke: var(--text-muted);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .footer-email {
            color: var(--accent);
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .footer-email:hover { opacity: 0.8; }

        .footer-copyright {
            font-size: 12px;
            color: var(--text-muted);
            opacity: 0.6;
        }

        /* ── 페이드인 애니메이션 ── */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .animate-in {
            animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
        }

        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }
        .delay-5 { animation-delay: 0.40s; }
        .delay-6 { animation-delay: 0.48s; }

        /* 게임 배지 (노란 계열) */
        .card-badge.game {
            background: rgba(248, 208, 48, 0.12);
            color: #f8d030;
        }

        /* ── 반응형 ── */
        @@media (max-width: 480px) {
            .container { padding: 40px 16px 60px; }
            .profile-name { font-size: 24px; }
            .profile-avatar { width: 72px; height: 72px; font-size: 30px; }
            .project-card { padding: 18px; gap: 14px; }
            .card-icon-img { width: 44px; height: 44px; border-radius: 12px; }
            .card-title { font-size: 15px; }
            .card-desc { font-size: 13px; }
        }
        /* ── 로그인 상태 바 (오른쪽 위) ── */
        .auth-bar { position: fixed; top: calc(12px + env(safe-area-inset-top, 0px)); right: 16px; z-index: 50; display: flex; align-items: center; gap: 10px; font-size: 13px; }
        .auth-name { color: var(--text-secondary); }
        .auth-link { color: var(--accent); text-decoration: none; }
        .auth-btn { background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font: inherit; cursor: pointer; text-decoration: none; }
        .auth-btn:hover { border-color: var(--accent); }
        /* ── 광고 자리 ── */
        /* 양옆 세로 광고: 본문(720px) 양쪽에 160px씩 들어갈 공간이 있을 때만 (1120px 이상) */
        .ad-side { position: fixed; top: 96px; width: 160px; z-index: 5; display: none; }
        .ad-left { left: calc(50% - 360px - 200px); }
        .ad-right { right: calc(50% - 360px - 200px); }
        .ad-side:empty { display: none !important; }
        .ad-inline { margin: 24px 0; }
        @@media (min-width: 1120px) { .ad-side { display: block; } .ad-inline { display: none; } }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body>
    <!-- 로그인 상태 (휴대폰에서도 여기서 로그인 → 게임 기록이 계정에 저장됨) -->
    <div class="auth-bar" id="authBar"><a href="/signin?returnUrl=/" class="auth-btn">로그인</a></div>
    <!-- 광고: 넓은 화면에서 본문 양옆 (스크롤해도 따라옴) -->
    <aside class="ad-side ad-left" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <aside class="ad-side ad-right" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <div class="container">

        <!-- 프로필 헤더 -->
        <div class="profile animate-in">
            <div class="profile-avatar">D</div>
            <div class="profile-handle">@@domang</div>
            <h1 class="profile-name">domang.org</h1>
            <p class="profile-bio">
                웹 서비스 개발 &amp; 인프라 운영<br />
                검색엔진, 클라우드 스토리지, OTT 멀티뷰어 등 직접 만들고 운영하는 프로젝트들
            </p>
        </div>

        <!-- 프로젝트 목록 -->
        <div class="section-title animate-in delay-1">Projects</div>
        <div class="projects">

            <!-- Meta Search → 설명 페이지로 이동 -->
            <a href="/metaindex" class="project-card animate-in delay-2" style="--card-accent: rgba(59, 130, 246, 0.08);">
                <div class="card-header">
                    <!-- 카드 아이콘: 생성 이미지 사용 -->
                    <img src="/img/metasearch-card.png" alt="" class="card-icon-img" />
                    <div class="card-body">
                        <div class="card-title">
                            Meta Search
                            <span class="card-badge">Live</span>
                        </div>
                        <div class="card-desc">
                            구글, 네이버, 다음, 빙, 유튜브, 나무위키를 한 번에 검색하는 통합 메타 검색엔진. AI 추천 검색, 인기검색어 TOP10, 실시간 트렌드 제공.
                        </div>
                    </div>
                    <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </div>
                <div class="tech-stack">
                    <span class="tech-tag">ASP.NET Core 8</span>
                    <span class="tech-tag">PostgreSQL</span>
                    <span class="tech-tag">Dapper</span>
                    <span class="tech-tag">Tailwind CSS</span>
                </div>
            </a>

            <!-- Cloud Drive → 설명 페이지로 이동 -->
            <a href="/driveindex" class="project-card animate-in delay-3" style="--card-accent: rgba(62, 207, 142, 0.08);">
                <div class="card-header">
                    <!-- 카드 아이콘: 생성 이미지 사용 -->
                    <img src="/img/drive-card.png" alt="" class="card-icon-img" />
                    <div class="card-body">
                        <div class="card-title">
                            Cloud Drive
                            <span class="card-badge">Live</span>
                        </div>
                        <div class="card-desc">
                            개인 클라우드 드라이브. 파일 업로드·다운로드, 폴더 관리, 청크 업로드로 대용량 파일 지원.
                        </div>
                    </div>
                    <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </div>
                <div class="tech-stack">
                    <span class="tech-tag">ASP.NET Core 8</span>
                    <span class="tech-tag">Chunk Upload</span>
                    <span class="tech-tag">SSD Storage</span>
                </div>
            </a>

            <!-- OTT Multi-View → 설명 페이지로 이동 -->
            <a href="/ottindex" class="project-card animate-in delay-4" style="--card-accent: rgba(229, 9, 20, 0.08);">
                <div class="card-header">
                    <!-- 카드 아이콘: 생성 이미지 사용 -->
                    <img src="/img/ott-card.png" alt="" class="card-icon-img" />
                    <div class="card-body">
                        <div class="card-title">
                            OTT Multi-View
                            <span class="card-badge desktop">Desktop</span>
                        </div>
                        <div class="card-desc">
                            넷플릭스, 유튜브 등 OTT 서비스를 최대 4개 동시 시청하는 데스크탑 멀티뷰어. PiP, 레이아웃 저장, 음량 개별 조절.
                        </div>
                    </div>
                    <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </div>
                <div class="tech-stack">
                    <span class="tech-tag">WinForms</span>
                    <span class="tech-tag">WebView2</span>
                    <span class="tech-tag">.NET 8</span>
                    <span class="tech-tag">MSSQL</span>
                </div>
            </a>

            <!-- 포켓몬스터 아스테라 → 설명 페이지로 이동 -->
            <a href="/pokeindex" class="project-card animate-in delay-5" style="--card-accent: rgba(248, 208, 48, 0.08);">
                <div class="card-header">
                    <!-- 카드 아이콘: Higgsfield 생성 이미지 사용 -->
                    <img src="/img/pokemon-card.png" alt="" class="card-icon-img" />
                    <div class="card-body">
                        <div class="card-title">
                            포켓몬스터 아스테라
                            <span class="card-badge game">Game</span>
                        </div>
                        <div class="card-desc">
                            신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임. 1~9세대 포켓몬, 메가진화·다이맥스·테라스탈, 회원 서버 저장. 브라우저에서 바로 플레이.
                        </div>
                    </div>
                    <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </div>
                <div class="tech-stack">
                    <span class="tech-tag">HTML5 Canvas</span>
                    <span class="tech-tag">JavaScript</span>
                    <span class="tech-tag">PostgreSQL</span>
                </div>
            </a>

        </div>

        <!-- 하단 링크 -->
