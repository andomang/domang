@page "/drive"
@model MetaSearch.Pages.DriveModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CloudDrive — 로그인</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@0.344.0/dist/umd/lucide.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        /* 배경 그라데이션 애니메이션 */
        .bg-animate {
            background: linear-gradient(-45deg, #0f172a, #1e1b4b, #172554, #0c0a1d);
            background-size: 400% 400%;
            animation: bgShift 12s ease infinite;
        }
        @@keyframes bgShift {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        /* 카드 글래스모피즘 */
        .glass {
            background: rgba(30, 27, 75, 0.4);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(99, 102, 241, 0.15);
        }
        /* 인풋 포커스 효과 */
        .input-glow:focus {
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
        }
        /* 로딩 스피너 */
        .spinner { animation: spin 0.8s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="bg-animate min-h-screen flex items-center justify-center p-4">
    <!-- 로그인 카드 -->
    <div class="glass rounded-2xl p-8 w-full max-w-md shadow-2xl">
        <!-- 로고 -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-600/30 border border-indigo-500/30 mb-4">
                <i data-lucide="cloud" class="w-8 h-8 text-indigo-400"></i>
            </div>
            <h1 class="text-2xl font-bold text-white">CloudDrive</h1>
            <p class="text-slate-400 text-sm mt-1">개인 클라우드 스토리지</p>
        </div>

        <!-- 에러 메시지 -->
        <div id="msg" class="hidden mb-4 px-4 py-3 rounded-lg text-sm bg-red-500/20 text-red-300 border border-red-500/30"></div>

        <!-- 로그인 폼 -->
        <form onsubmit="return handleLogin(event)" class="space-y-4">
            <div>
                <label class="block text-sm text-slate-300 mb-1.5">아이디</label>
                <div class="relative">
                    <i data-lucide="user" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500"></i>
                    <input type="text" id="loginId" required autocomplete="username"
                           class="input-glow w-full bg-slate-800/60 border border-slate-700 rounded-xl pl-10 pr-4 py-3 text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none transition"
                           placeholder="아이디 입력" />
                </div>
            </div>
            <div>
                <label class="block text-sm text-slate-300 mb-1.5">비밀번호</label>
                <div class="relative">
                    <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500"></i>
                    <input type="password" id="loginPw" required autocomplete="current-password"
                           class="input-glow w-full bg-slate-800/60 border border-slate-700 rounded-xl pl-10 pr-4 py-3 text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none transition"
                           placeholder="비밀번호 입력" />
                </div>
            </div>
            <button type="submit" id="loginBtn"
                    class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all flex items-center justify-center gap-2">
                <span>로그인</span>
            </button>
        </form>
    </div>

    <script>
        lucide.createIcons();

        // 이미 로그인 상태면 파일 탐색기로 이동
        const driveToken = localStorage.getItem('driveToken');
        if (driveToken) {
            fetch('/api/drive/me', { headers: { 'Authorization': 'Bearer ' + driveToken } })
                .then(r => { if (r.ok) location.href = '/drive/files'; });
        }

        function showMsg(text) {
            const el = document.getElementById('msg');
            el.textContent = text;
            el.classList.remove('hidden');
        }

        async function handleLogin(e) {
            e.preventDefault();
            const id = document.getElementById('loginId').value.trim();
            const pw = document.getElementById('loginPw').value;
            const btn = document.getElementById('loginBtn');
            const span = btn.querySelector('span');

            btn.disabled = true;
            span.textContent = '로그인 중...';
            try {
                const res = await fetch('/api/drive/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: id, password: pw })
                });
                const data = await res.json();
                if (res.ok && data.token) {
                    localStorage.setItem('driveToken', data.token);
                    location.href = '/drive/files';
                } else {
                    showMsg(data.error || '로그인 실패');
                }
            } catch { showMsg('서버 연결 실패'); }
            finally { btn.disabled = false; span.textContent = '로그인'; }
            return false;
        }
    </script>
</body>
</html>
