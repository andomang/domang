@inject Lang Lang
@inject MemberDao MemberDao
@inject Services.DbService Db
@using Microsoft.AspNetCore.DataProtection
@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection
@{
    // 쿠키 → 세션 동기화 (다크모드)
    bool isDark = false;
    if (Context.Request.Cookies.ContainsKey("DarkMode"))
    {
        isDark = Context.Request.Cookies["DarkMode"] == "1";
        Context.Session.SetString("IsDark", isDark.ToString());
    }
    else if (Context.Session.GetString("IsDark") != null)
    {
        isDark = Context.Session.GetString("IsDark") == "True";
    }

    // 쿠키 → 세션 동기화 (언어)
    if (Context.Request.Cookies.ContainsKey("Language"))
    {
        string cookieLang = Context.Request.Cookies["Language"];
        if (Context.Session.GetString("Lang") != cookieLang)
            Context.Session.SetString("Lang", cookieLang);
    }

    // 쿠키 자동 로그인 (UserID 쿠키가 있지만 세션이 없는 경우)
    string uid = Context.Session.GetString("UserID");
    if (uid == null && Context.Request.Cookies.ContainsKey("UserID"))
    {
        // 서명을 확인해서 아이디를 꺼냄. 위조·예전 형식(서명 없음) 쿠키는 빈 값 → 아래에서 쿠키 삭제
        string cookieUid = "";
        try { cookieUid = DataProtection.CreateProtector("AutoLogin").Unprotect(Context.Request.Cookies["UserID"] ?? "").Trim().ToLowerInvariant(); }
        catch (System.Security.Cryptography.CryptographicException) { }
        // DB에서 활성 유저 존재 여부 확인 (소문자 정규화 + 탈퇴·삭제된 계정 쿠키 방지)
        using (var conn = Db.OpenConnection())
        {
            var exists = Dapper.SqlMapper.QueryFirstOrDefault<string>(conn,
                "SELECT userid FROM members WHERE LOWER(userid)=@cookieUid AND (TRIM(status)='true' OR TRIM(status)='1')",
                new { cookieUid });
            if (exists != null)
            {
                uid = cookieUid;
                Context.Session.SetString("UserID", uid);
                string nick = MemberDao.GetNickname(uid);
                Context.Session.SetString("UserName", nick);
                var (dm, lg) = MemberDao.GetUserSettings(uid);
                Context.Session.SetString("IsDark", dm.ToString());
                Context.Session.SetString("Lang", lg);
                isDark = dm;
            }
            else
            {
                // 존재하지 않는 유저 — 쿠키 삭제
                Context.Response.Cookies.Delete("UserID");
            }
        }
    }

    // 알림 배지 (로그인 시만, 60초 세션 캐싱으로 매 페이지 DB 부하 방지)
    int unreadCount = 0;
    if (uid != null)
    {
        string cachedCount = Context.Session.GetString("NotifCount");
        string cachedTime = Context.Session.GetString("NotifCountTime");
        bool useCache = false;
        if (cachedCount != null && cachedTime != null)
        {
            if (long.TryParse(cachedTime, out long ticks))
            {
                var elapsed = DateTime.UtcNow - new DateTime(ticks, DateTimeKind.Utc);
                if (elapsed.TotalSeconds < 60) { unreadCount = int.Parse(cachedCount); useCache = true; }
            }
        }
        if (!useCache)
        {
            try
            {
                using var conn = Db.OpenConnection();
                unreadCount = Dapper.SqlMapper.QuerySingleOrDefault<int>(conn,
                    "SELECT COUNT(*) FROM notifications WHERE userid=@uid AND isread=false",
                    new { uid });
                Context.Session.SetString("NotifCount", unreadCount.ToString());
                Context.Session.SetString("NotifCountTime", DateTime.UtcNow.Ticks.ToString());
            }
            catch { }
        }
    }

    string userName = Context.Session.GetString("UserName") ?? uid;

    // 관리자 여부 확인 (config AdminUsers 또는 DB isadmin=1)
    bool isAdminUser = false;
    if (uid != null)
    {
        var cfgAdmins = Configuration.GetSection("AdminUsers").Get<string[]>() ?? new[] { "test" };
        if (cfgAdmins.Any(a => string.Equals(a.Trim(), uid, StringComparison.OrdinalIgnoreCase)))
        {
            isAdminUser = true;
        }
        else
        {
            try
            {
                using var conn = Db.OpenConnection();
                var val = Dapper.SqlMapper.ExecuteScalar<int?>(conn,
                    "SELECT isadmin FROM members WHERE userid = @uid", new { uid });
                isAdminUser = val == 1;
            }
            catch { }
        }
    }

    // 현재 요청 호스트에 맞는 기본 URL (domang.org / metasearch.kro.kr 둘 다 지원)
    string baseUrl = $"https://{Context.Request.Host}";
}
