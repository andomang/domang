@page "/metaindex"
@model MetaIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meta Search — 프로젝트 소개</title>
    <meta name="description" content="Meta Search 통합 검색엔진 프로젝트 소개. 구글, 네이버, 다음, 빙, 유튜브를 한 번에 검색." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/metaindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/metaindex" />
    <meta property="og:title" content="Meta Search — 프로젝트 소개" />
    <meta property="og:description" content="Meta Search 통합 검색엔진 프로젝트 소개. 구글, 네이버, 다음, 빙, 유튜브를 한 번에 검색." />
    <meta property="og:image" content="https://domang.org/img/og/metasearch.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Meta Search — 프로젝트 소개" />
    <meta name="twitter:description" content="Meta Search 통합 검색엔진 프로젝트 소개. 구글, 네이버, 다음, 빙, 유튜브를 한 번에 검색." />
    <meta name="twitter:image" content="https://domang.org/img/og/metasearch.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "Meta Search",
      "url": "https://domang.org/metasearch",
      "applicationCategory": "SearchApplication",
      "operatingSystem": "Web",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "description": "Meta Search 통합 검색엔진 프로젝트 소개. 구글, 네이버, 다음, 빙, 유튜브를 한 번에 검색.",
      "image": "https://domang.org/img/og/metasearch.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />

    <style>
        /* ── 리셋 ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0f0d;
            --bg-card: #141f1a;
            --border: #1e3a2d;
            --border-hover: #2d5a43;
            --text-primary: #e8f0ec;
            --text-secondary: #8fa89a;
            --text-muted: #5a7568;
            --accent: #3b82f6;
            --accent-dim: rgba(59, 130, 246, 0.12);
            --accent-glow: rgba(59, 130, 246, 0.25);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-mono: 'JetBrains Mono', 'Consolas', monospace;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── 배경 효과 ── */
        body::before {
            content: '';
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 20%, rgba(59, 130, 246, 0.06) 0%, transparent 60%),
                        radial-gradient(ellipse at 70% 80%, rgba(139, 92, 246, 0.04) 0%, transparent 60%);
            z-index: -1;
        }

        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 20px 80px;
        }

        /* ── 상단 바로가기 바 ── */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
        }

        .back-link {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-link:hover { color: var(--text-primary); }

        .back-link svg { width: 16px; height: 16px; }

        /* 바로가기 버튼 */
        .goto-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: var(--accent);
            color: white;
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
        }

        .goto-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(59, 130, 246, 0.4);
        }

        .goto-btn svg { width: 16px; height: 16px; }

        /* ── 히어로 영역 ── */
        .hero {
            text-align: center;
            margin-bottom: 48px;
        }

        .hero-icon {
            width: 80px; height: 80px;
            border-radius: 20px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);
        }

        .hero-icon svg {
            width: 40px; height: 40px;
            fill: none; stroke: white;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .hero h1 {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .hero-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 3px 10px;
            border-radius: 6px;
            background: var(--accent-dim);
            color: var(--accent);
            margin-bottom: 16px;
        }

        .hero p {
            font-size: 16px;
            color: var(--text-secondary);
            line-height: 1.7;
            max-width: 560px;
            margin: 0 auto;
        }

        /* ── 썸네일 이미지 ── */
        .hero-img {
            width: 100%;
            border-radius: 16px;
            border: 1px solid var(--border);
            margin-bottom: 48px;
            box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
        }

        /* ── 기능 섹션 ── */
        .section-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-muted);
            margin-bottom: 20px;
            padding-left: 4px;
        }

        .features {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 40px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 16px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .feature-icon {
            flex-shrink: 0;
            width: 36px; height: 36px;
            border-radius: 10px;
            background: var(--accent-dim);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feature-icon svg {
            width: 18px; height: 18px;
            fill: none; stroke: var(--accent);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        .feature-text h3 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .feature-text p {
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* ── 기술 스택 ── */
        .tech-section { margin-bottom: 40px; }

        .tech-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tech-chip {
            font-family: var(--font-mono);
            font-size: 12px;
            padding: 6px 14px;
            border-radius: 8px;
            background: var(--bg-card);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        /* ── 하단 바로가기 ── */
        .bottom-cta {
            text-align: center;
            padding-top: 40px;
            border-top: 1px solid var(--border);
        }

        .bottom-cta p {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        /* ── 연락처 & 저작권 ── */
        .site-footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 24px;
            border-top: 1px solid var(--border);
        }
        .footer-contact {
            display: flex; align-items: center; justify-content: center;
            flex-wrap: wrap; gap: 6px; font-size: 13px;
            color: var(--text-muted); margin-bottom: 10px;
        }
        .footer-name { font-weight: 600; color: var(--text-secondary); }
        .footer-divider { opacity: 0.4; }
        .footer-ico {
            width: 14px; height: 14px; flex-shrink: 0;
            fill: none; stroke: var(--text-muted);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .footer-email { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
        .footer-email:hover { opacity: 0.8; }
        .footer-copyright { font-size: 12px; color: var(--text-muted); opacity: 0.6; }

        /* ── 애니메이션 ── */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .animate-in {
            animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
        }

        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }

        /* ── 반응형 ── */
        @@media (max-width: 480px) {
            .hero h1 { font-size: 24px; }
            .hero-icon { width: 64px; height: 64px; border-radius: 16px; }
            .hero-icon svg { width: 32px; height: 32px; }
            .top-bar { flex-direction: column; gap: 12px; align-items: stretch; text-align: center; }
            .goto-btn { justify-content: center; }
        }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body>
    <div class="container">

        <!-- 상단 네비게이션 + 바로가기 -->
        <div class="top-bar animate-in">
            <a href="/" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                포트폴리오로 돌아가기
            </a>
            <a href="/metasearch" class="goto-btn">
                Meta Search 바로가기
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </a>
        </div>

        <!-- 히어로 -->
        <div class="hero animate-in delay-1">
            <div class="hero-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </div>
            <span class="hero-badge">Live Service</span>
            <h1>Meta Search</h1>
            <p>
                구글, 네이버, 다음, 빙을 한 번에 검색하는 통합 메타 검색엔진입니다.
                각 엔진의 결과를 AI가 분석·재정렬하여 최적의 검색 결과를 제공합니다.
            </p>
        </div>

        <!-- 썸네일 -->
        <img src="/img/metasearch-card.png" alt="Meta Search 스크린샷" class="hero-img animate-in delay-2" />

        <!-- 주요 기능 -->
        <div class="section-title animate-in delay-2">주요 기능</div>
        <div class="features animate-in delay-2">
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                </div>
                <div class="feature-text">
                    <h3>4대 엔진 통합 검색</h3>
                    <p>Google, Naver, Daum, Brave 4개 검색엔진을 병렬로 크롤링하여 RRF(Reciprocal Rank Fusion) 알고리즘으로 결합합니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>
                </div>
                <div class="feature-text">
                    <h3>AI 결과 재정렬</h3>
                    <p>Claude AI가 검색 의도를 분석하고, 결과의 관련성을 평가하여 최적 순서로 재정렬합니다. 관련 검색어도 자동 추천합니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 20V10" /><path d="M18 20V4" /><path d="M6 20v-4" /></svg>
                </div>
                <div class="feature-text">
                    <h3>개인화 엔진 가중치</h3>
                    <p>사용자의 클릭 패턴과 검색 키워드 분야에 따라 엔진별 가중치가 자동으로 조정되어 점점 더 나은 결과를 제공합니다.</p>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                </div>
                <div class="feature-text">
                    <h3>인기검색어 TOP10 &amp; 트렌드</h3>
                    <p>실시간 인기검색어 순위와 트렌드를 DB 캐싱으로 빠르게 제공합니다. 자동완성 검색어 추천도 지원합니다.</p>
                </div>
            </div>
        </div>

        <!-- 기술 스택 -->
        <div class="tech-section animate-in delay-3">
            <div class="section-title">기술 스택</div>
            <div class="tech-grid">
                <span class="tech-chip">ASP.NET Core 8</span>
                <span class="tech-chip">Razor Pages</span>
                <span class="tech-chip">PostgreSQL</span>
                <span class="tech-chip">Dapper</span>
                <span class="tech-chip">Tailwind CSS</span>
                <span class="tech-chip">Claude AI API</span>
                <span class="tech-chip">Nginx</span>
                <span class="tech-chip">Raspberry Pi 4</span>
                <span class="tech-chip">Cloudflare Tunnel</span>
            </div>
        </div>

        <!-- 하단 바로가기 -->
        <div class="bottom-cta animate-in delay-4">
            <p>직접 사용해 보세요</p>
            <a href="/metasearch" class="goto-btn">
                Meta Search 바로가기
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </a>
        </div>

        <!-- 연락처 & 저작권 -->
        <!-- 광고: 본문 아래 -->
        <div style="margin:24px 0"><partial name="_AdUnit" model='@("inline")' /></div>

        <footer class="site-footer animate-in delay-5">
            <div class="footer-contact">
                <span class="footer-name">안도영</span>
                <span class="footer-divider">·</span>
                <svg class="footer-ico" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <span>010-2583-1894</span>
                <span class="footer-divider">·</span>
                <svg class="footer-ico" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                <a href="mailto:metasearch@@domang.org" class="footer-email">metasearch@@domang.org</a>
            </div>
            <p class="footer-copyright">&copy; 2026 안도영 (domang.org). All rights reserved. · <a href="/Privacy" style="color:inherit;text-decoration:underline">개인정보처리방침</a></p>
        </footer>

    </div>
</body>
</html>
