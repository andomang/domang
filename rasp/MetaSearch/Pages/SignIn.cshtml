@page "/signin"
@model SignInModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>domang 로그인</title>
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />
    <style>
        /* 포트폴리오(domang.org)와 같은 어두운 톤 + 포켓몬 페이지의 노랑 포인트 */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #0a0f0d; --card: #141f1a; --border: #1e3a2d; --text: #e8f0ec; --sub: #8fa89a; --muted: #5a7568;
            --accent: #f8d030; --red: #e53935;
        }
        html, body { height: 100%; }
        body {
            font-family: 'Inter', -apple-system, 'Segoe UI', 'Malgun Gothic', sans-serif; background: var(--bg); color: var(--text);
            display: flex; align-items: center; justify-content: center; padding: 24px 16px;
        }
        .card { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 28px 24px; }
        .brand { font-size: 13px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 6px; }
        h1 { font-size: 24px; font-weight: 800; margin-bottom: 6px; }
        .lead { font-size: 13px; color: var(--sub); line-height: 1.6; margin-bottom: 22px; }
        label { display: block; font-size: 12px; font-weight: 600; color: var(--sub); margin: 0 0 6px 2px; }
        input {
            width: 100%; padding: 13px 14px; margin-bottom: 14px; border-radius: 10px; border: 1px solid var(--border);
            background: #0d1512; color: var(--text); font-size: 16px; /* 16px: 아이폰 자동 확대 방지 */
        }
        input:focus { outline: none; border-color: var(--accent); }
        .btn { width: 100%; padding: 13px; border: 0; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; background: var(--red); color: #fff; }
        .btn:disabled { opacity: .6; }
        .btn.ghost { background: transparent; border: 1px solid var(--border); color: var(--sub); margin-top: 10px; }
        .err { min-height: 18px; font-size: 13px; color: #ff7b7b; margin: -4px 0 10px 2px; }
        .links { display: flex; justify-content: space-between; gap: 10px; margin-top: 18px; font-size: 13px; }
        .links a { color: var(--accent); text-decoration: none; }
        .me { font-size: 15px; margin-bottom: 18px; line-height: 1.6; }
        .me b { color: var(--accent); }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body>
    <main class="card">
        <div class="brand">domang.org</div>
        @if (Model.UserId != null)
        {
            <!-- 이미 로그인한 경우 -->
            <h1>로그인되어 있어요</h1>
            <p class="me"><b>@Model.UserName</b> (@Model.UserId) 님으로 로그인 중입니다.</p>
            <a class="btn" style="display:block;text-align:center;text-decoration:none" href="@Model.ReturnUrl">계속하기</a>
            <button class="btn ghost" id="logout">로그아웃</button>
        }
        else
        {
            <h1>로그인</h1>
            <p class="lead">domang.org 회원 계정으로 로그인하면 포켓몬스터 아스테라 기록이 계정에 저장되어 휴대폰과 컴퓨터에서 이어서 할 수 있습니다.</p>
            <form id="f" autocomplete="on">
                <label for="id">아이디</label>
                <input id="id" name="username" autocomplete="username" autocapitalize="off" required />
                <label for="pw">비밀번호</label>
                <input id="pw" name="password" type="password" autocomplete="current-password" required />
                <div class="err" id="err"></div>
                <button class="btn" id="go" type="submit">로그인</button>
            </form>
            <div class="links">
                <a href="/metasearch/register">회원가입</a>
                <a href="/metasearch/find-account">아이디·비밀번호 찾기</a>
            </div>
        }
    </main>
    <script>
        // 로그인 후 돌아갈 주소 (서버에서 같은 사이트 경로만 허용해 넘겨줌)
        var back = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReturnUrl));
        var f = document.getElementById('f');
        if (f) f.addEventListener('submit', function (e) {
            e.preventDefault();
            var go = document.getElementById('go'), err = document.getElementById('err');
            go.disabled = true; err.textContent = '';
            fetch('/api/astera/login', {
                method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: document.getElementById('id').value.trim(), pw: document.getElementById('pw').value })
            }).then(function (r) { return r.json(); }).then(function (j) {
                if (j.ok) { location.href = back; return; }
                err.textContent = j.error || '로그인에 실패했습니다.'; go.disabled = false;
            }).catch(function () { err.textContent = '서버에 연결하지 못했습니다.'; go.disabled = false; });
        });
        var lo = document.getElementById('logout');
        if (lo) lo.addEventListener('click', function () {
            fetch('/api/astera/logout', { method: 'POST', credentials: 'same-origin' }).then(function () { location.reload(); });
        });
    </script>
</body>
</html>
